<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="28dp"
        android:paddingBottom="36dp">

        <!-- ===== 头部 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="大肥鱼桌宠"
            android:textColor="@color/fg"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"
            android:lineSpacingExtra="3dp"
            android:text="95 个动作 · 常驻桌面 · 长按她可以换动作或改设置"
            android:textColor="@color/sub"
            android:textSize="13sp" />

        <!-- ===== 主开关 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="桌面常驻"
                    android:textColor="@color/fg"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="已关闭"
                    android:textColor="@color/dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/swMaster"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/accent" />
        </LinearLayout>

        <!-- ===== 权限 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="9dp"
            android:text="必要权限"
            android:textColor="@color/sub"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingRight="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <!-- 悬浮窗 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="显示在其他应用上层"
                        android:textColor="@color/fg"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvOverlay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="未授予 · 没有它鲸鱼浮不到桌面上"
                        android:textColor="@color/warn"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/btn_primary"
                    android:minWidth="0dp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="去授权"
                    android:textAllCaps="false"
                    android:textColor="@color/fg"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />

            <!-- 通知 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="常驻通知"
                        android:textColor="@color/fg"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvNotif"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="允许后可在通知栏一键显示/关闭"
                        android:textColor="@color/dim"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnNotif"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/btn"
                    android:minWidth="0dp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="去开启"
                    android:textAllCaps="false"
                    android:textColor="@color/fg"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />

            <!-- 电池 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="忽略电池优化"
                        android:textColor="@color/fg"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvBattery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="不设置的话，锁屏久了可能被系统清掉"
                        android:textColor="@color/dim"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/btn"
                    android:minWidth="0dp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="去设置"
                    android:textAllCaps="false"
                    android:textColor="@color/fg"
                    android:textSize="12.5sp" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />

            <!-- 使用情况访问（判断当前是不是在桌面） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="使用情况访问"
                        android:textColor="@color/fg"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvUsage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="用来判断当前是不是在桌面"
                        android:textColor="@color/dim"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnUsage"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/btn"
                    android:minWidth="0dp"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="去授权"
                    android:textAllCaps="false"
                    android:textColor="@color/fg"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 外观 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="9dp"
            android:text="外观"
            android:textColor="@color/sub"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="大小"
                    android:textColor="@color/fg"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="96 dp"
                    android:textColor="@color/sub"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sbSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="240"
                android:progress="36"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="透明度"
                    android:textColor="@color/fg"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvAlpha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100%"
                    android:textColor="@color/sub"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sbAlpha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="70"
                android:progress="70"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />

        </LinearLayout>

        <!-- ===== 行为 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="9dp"
            android:text="行为"
            android:textColor="@color/sub"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingRight="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="11dp"
                android:paddingBottom="11dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="自动漫游"
                        android:textColor="@color/fg"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="每隔十几秒自己挪一段"
                        android:textColor="@color/dim"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swRoam"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/accent" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="11dp"
                android:paddingBottom="11dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="点她换动作"
                        android:textColor="@color/fg"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="点击行为（点右侧切换）"
                        android:textColor="@color/dim"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/swTap"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/btn"
                    android:minWidth="0dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="全部动作随机"
                    android:textAllCaps="false"
                    android:textColor="@color/accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="11dp"
                android:paddingBottom="11dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="只在桌面显示"
                        android:textColor="@color/fg"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="切到别的 App 就自动藏起来，回桌面再出现"
                        android:textColor="@color/dim"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/accent" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="11dp"
                android:paddingBottom="11dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="开机自动显示"
                        android:textColor="@color/fg"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="重启手机后自动把鲸鱼放回桌面"
                        android:textColor="@color/dim"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swBoot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="@color/accent" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 操作说明 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="9dp"
            android:text="桌面上的操作"
            android:textColor="@color/sub"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:text="轻点她 —— 默认随机播放任意动作\n按住拖动 —— 换个位置（松手记住）\n长按她 —— 弹出动作库，16 类 95 个动作 × 4 种变体\n动作库里切到「设置」还能改大小、透明度、换常驻动作"
                android:textColor="@color/sub"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="4dp"
            android:text="提示：小米 / 华为 / OPPO / vivo 等机型还需要在「自启动管理」或「后台运行」里把本应用放行，否则重启或锁屏久了可能被系统清掉。"
            android:textColor="@color/dim"
            android:textSize="11.5sp" />
    </LinearLayout>
</ScrollView>
